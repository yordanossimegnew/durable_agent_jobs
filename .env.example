# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL: the job queue, event log and LangGraph checkpoints all live here.
#   In psql:  CREATE DATABASE durable_jobs;  CREATE DATABASE durable_jobs_test;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/durable_jobs
# Used only by pytest (tables are truncated between tests: never point this at real data)
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/durable_jobs_test

# Optional overrides
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
WEB_SEARCH_MAX_USES=4          # web searches per research question
WORKER_LEASE_SECONDS=30        # reclaim a job if its worker is silent this long
WORKER_HEARTBEAT_SECONDS=5
JOB_MAX_ATTEMPTS=3             # then the job fails permanently
RETRY_BASE_SECONDS=5           # backoff: base * 2^(attempt-1), with jitter
RETRY_MAX_SECONDS=300
EMBEDDED_WORKERS=0             # >0 runs workers inside the API process
ALLOW_CHAOS=false              # true enables the "kill the worker after N steps" demo option
LOG_LEVEL=INFO
